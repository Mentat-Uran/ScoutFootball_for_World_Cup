{
  "name": "scoutfootball",
  "version": "1.0.3",
  "description": "ScoutFootball — Local-first football analytics platform",
  "main": "main.js",
  "author": "Mentaturan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --arm64",
    "build:mac": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder --mac --arm64 --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.scoutfootball.desktop",
    "productName": "ScoutFootball",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "frontend/**/*"
    ],
    "extraResources": [
      {
        "from": "backend-dist/scoutfootball-server/",
        "to": "backend/"
      },
      {
        "from": "../data/gold/feature_store/",
        "to": "data/gold/feature_store/"
      },
      {
        "from": "../data/gold/scoutlab.duckdb",
        "to": "data/gold/scoutlab.duckdb"
      },
      {
        "from": "../data/models/",
        "to": "data/models/"
      },
      {
        "from": "../data/reports/",
        "to": "data/reports/"
      },
      {
        "from": "../data/raw/statsbomb_open/",
        "to": "data/raw/statsbomb_open/"
      }
    ],
    "mac": {
      "category": "public.app-category.sports",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "artifactName": "ScoutFootball-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScoutFootball",
      "artifactName": "ScoutFootball-Setup-${version}-win-x64.${ext}",
      "unicode": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
